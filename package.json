{
  "name": "kairos",
  "version": "1.0.0",
  "description": "Kairos is a customer data engine designed to collect, unify, and process customer data in real-time.",
  "keywords": [
    "kairos",
    "Customer Data Engine"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx watch src/index.ts | pino-pretty",
    "test": "NODE_ENV=test vitest run --coverage",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "serve": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch:test": "vitest watch",
    "watch:build": "tsc -p tsconfig.build.json --noEmit --watch"
  },
  "dependencies": {
    "@koala-ts/framework": "^2.18.0",
    "jose": "^6.2.3",
    "mongodb": "^7.1.0",
    "pino": "^10.1.0",
    "remeda": "^2.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "pino-pretty": "^13.1.3",
    "pino-test": "^2.0.0",
    "prettier": "^3.7.4",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.0.16"
  }
}
